# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_GENERATOR_MODEL=gpt-4o
OPENAI_CRITIC_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Tavily Web Search API (Optional: fallback to DuckDuckGo if blank)
TAVILY_API_KEY=your_tavily_api_key_here

# Vector Store Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=self_correcting_rag

# Self-Correction Thresholds & Parameters
CRAG_UPPER_THRESHOLD=0.70
CRAG_LOWER_THRESHOLD=0.30
CRAG_STRIP_TOP_K=5
MAX_RETRY_COUNT=2

# Observability (Optional: LangSmith tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Self-Correcting-RAG
